# ==============================================================================
# AI MEDICINE ASSISTANT: ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_PORT=8000
FRONTEND_PORT=3000

# Security & Authentication
JWT_SECRET_KEY=generate_a_secure_high_entropy_secret_key_here_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Hardware Acceleration & Compute Device (auto, cuda, cpu)
DEVICE=auto
MIXED_PRECISION=fp16

# AI / ML Model Configurations
MODEL_NAME=meta-llama/Meta-Llama-3-8B-Instruct
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-large
OCR_ENGINE=paddleocr

# Relational Database (PostgreSQL 16)
POSTGRES_USER=medicine_user
POSTGRES_PASSWORD=medicine_secure_pass
POSTGRES_DB=medicine_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://medicine_user:medicine_secure_pass@localhost:5432/medicine_ai

# Caching & Message Queue (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=http://localhost:5000

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
